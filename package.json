{
  "name": "hyperfin-terminal",
  "version": "0.0.4",
  "description": "A CLI Interface to Financial Market Data.",
  "keywords": [
    "Ethereum",
    "finance",
    "blockchain",
    "markets",
    "defi",
    "decentralized"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "J. Farid",
  "bin": {
    "open-eth-terminal": "./index.ts"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "cli": "npx tsx index.ts",
    "test": "deno test --allow-env --allow-read --allow-net --allow-sys",
    "test:e2e": "deno test test/e2e/ --allow-all",
    "test:all": "deno test --allow-all",
    "test:coverage": "deno test --allow-all --coverage=coverage",
    "tsc": "npx tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@observablehq/plot": "^0.6.17",
    "@types/terminal-kit": "^2.5.7",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "effect": "^3.22.1",
    "figlet": "^1.9.4",
    "jsdom": "^27.4.0",
    "open": "^11.0.0",
    "ramda": "^0.32.0",
    "rss-parser": "^3.13.0",
    "terminal-kit": "^3.1.4",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.77.0",
    "@types/figlet": "^1.7.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.9.5",
    "@types/ramda": "^0.31.1",
    "typescript": "^5.9.3"
  }
}
