{
    "imports": {
        "cli/": "./cli/",
        "terminal/": "./terminal/"
    },
    "compilerOptions": {
        "paths": {
            "cli/*": ["./cli/*"],
            "terminal/*": ["./terminal/*"]
        }
    },
    "tasks": {
        "cli": "deno run --allow-sys --allow-run --allow-net --allow-env --allow-read=.env,./tmp,./data,./portfolios,./scripts,./node_modules --allow-write=./tmp,./data index.ts",
        "terminal": "deno run --allow-sys --allow-run --allow-net --allow-env --allow-read=.env,./tmp,./data,./portfolios,./scripts,./node_modules --allow-write=./tmp,./data terminal.ts",
        "test": "deno test --allow-env --allow-read --allow-net --allow-sys --allow-run",
        "dev:debug": "deno run --inspect-wait=127.0.0.1:9229 --allow-sys --allow-run --allow-net --allow-env --allow-read=.env,./tmp,./data,./portfolios,./scripts,./node_modules --allow-write=./tmp,./data index.ts",
        "dev:debug:terminal": "deno run --inspect-wait=127.0.0.1:9229 --allow-sys --allow-run --allow-net --allow-env --allow-read=.env,./tmp,./data,./portfolios,./scripts,./node_modules --allow-write=./tmp,./data terminal.ts",
        "test:e2e": "deno test test/ --allow-all",
        "test:all": "deno test --allow-all",
        "test:coverage": "deno test --allow-all --coverage=coverage",
        "coverage:report": "deno coverage coverage --lcov > coverage.lcov",
        "coverage:html": "deno coverage coverage --html",
        "agents-copy": "deno run --allow-read --allow-write tasks/agents.ts"
    }
}